{
  "expo": {
    "name": "test-rtl",
    "slug": "test-rtl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rtltest.app"
    },
    "android": {
      "package": "com.rtltest.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": false
        }
      ],
      "react-native-edge-to-edge"
    ],
    "extra": {
      "note": "supportsRTL enables RTL; forcesRTL is left false because this app tests RUNTIME switching. Flip forcesRTL to true only for the Option-A (native force) comparison on Mac."
    }
  }
}
